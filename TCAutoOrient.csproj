<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)'==''">2024</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)'=='2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)'!='2024'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RuntimeTarget)'!=''">$(RuntimeTarget)</TargetFramework>
    <RevitPath Condition="'$(RevitPath)'==''">C:/Program Files/Autodesk/Revit $(RevitVersion)</RevitPath>
    <LangVersion>5</LangVersion><PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>TCAutoOrient</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/*.cs" />
    <Reference Include="RevitAPI"><HintPath>$(RevitPath)/RevitAPI.dll</HintPath><Private>false</Private><ExternallyResolved>true</ExternallyResolved></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitPath)/RevitAPIUI.dll</HintPath><Private>false</Private><ExternallyResolved>true</ExternallyResolved></Reference>
  </ItemGroup>
</Project>
